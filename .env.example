# ── Deployer ─────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x<your_private_key>
ADMIN_ADDRESS=0x<multisig_or_eoa>

# ── L2 RPC endpoints ─────────────────────────────────────────────────────────
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
OPTIMISM_SEPOLIA_RPC=https://sepolia.optimism.io
BASE_SEPOLIA_RPC=https://sepolia.base.org

# ── Mainnet RPC (for fork tests) ─────────────────────────────────────────────
MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/<key>

# ── Block explorer API keys ──────────────────────────────────────────────────
ARBISCAN_API_KEY=<your_arbiscan_key>
OP_ETHERSCAN_API_KEY=<your_op_key>
BASESCAN_API_KEY=<your_basescan_key>

# ── Token addresses (testnet) ────────────────────────────────────────────────
TOKEN_A=0x<weth_or_mock_tokenA>
TOKEN_B=0x<usdc_or_mock_tokenB>

# ── Chainlink price feeds (testnet) ──────────────────────────────────────────
CHAINLINK_FEED_A=0x<eth_usd_feed_arbitrum_sepolia>
CHAINLINK_FEED_B=0x<usdc_usd_feed_arbitrum_sepolia>
FEED_STALENESS=3600

# ── Protocol parameters ───────────────────────────────────────────────────────
GOV_TOKEN_MAX_SUPPLY=100000000000000000000000000
VAULT_PERF_FEE=1000

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_WALLETCONNECT_PROJECT_ID=<your_walletconnect_project_id>
VITE_ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
VITE_OPTIMISM_SEPOLIA_RPC=https://sepolia.optimism.io
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org

# Populated by Deploy.s.sol
VITE_ARB_GOV_TOKEN=0x
VITE_ARB_AMM=0x
VITE_ARB_LENDING=0x
VITE_ARB_VAULT=0x
VITE_ARB_GOVERNOR=0x
VITE_ARB_TIMELOCK=0x
VITE_ARB_TREASURY=0x
VITE_ARB_TOKEN_A=0x
VITE_ARB_TOKEN_B=0x
VITE_ARB_SUBGRAPH_URL=https://api.studio.thegraph.com/query/xxxxx/defi-super-app/version/latest

# ── The Graph ────────────────────────────────────────────────────────────────
GRAPH_STUDIO_KEY=<your_graph_studio_key>
